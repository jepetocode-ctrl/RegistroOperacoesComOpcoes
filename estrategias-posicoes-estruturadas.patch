+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Domain\TemplateConstraints;
+use App\Repositories\StrategyTemplateRepository;
+use PDO;
+use Throwable;
+
+final class StrategyTemplateService
+{
+    public function __construct(private readonly PDO $pdo, private readonly StrategyTemplateRepository $repository) {}
+
+    public function list(int $userId): array
+    {
+        return $this->repository->listVisible($userId);
+    }
+
+    public function find(int $userId, int $id): ?array
+    {
+        return $this->repository->findVisible($userId, $id);
+    }
+
+    /** Cria um modelo próprio do usuário. Não aceita contratos, preços, datas ou quantidades reais. */
+    public function create(int $userId, array $input): array
+    {
+        $errors = [];
+        $name = trim((string) ($input['name'] ?? ''));
+        if ($name === '' || mb_strlen($name) > 120) $errors['name'] = 'Informe um nome de até 120 caracteres.';
+
+        $slots = $input['slots'] ?? null;
+        $clean = [];
+        $keys = [];
+        if (!is_array($slots) || $slots === [] || !array_is_list($slots)) {
+            $errors['slots'] = 'Informe ao menos uma perna (slot).';
+        } else {
+            foreach ($slots as $i => $s) {
+                $field = "slots.{$i}";
+                if (!is_array($s)) { $errors[$field] = 'Slot inválido.'; continue; }
+                $key = (string) ($s['slot_key'] ?? '');
+                $side = strtoupper((string) ($s['side'] ?? ''));
+                $type = strtoupper((string) ($s['option_type'] ?? ''));
+                $ratio = filter_var($s['ratio'] ?? 1, FILTER_VALIDATE_INT);
+                if (!preg_match('/^[a-z][a-z0-9_]{0,39}$/', $key)) $errors["{$field}.slot_key"] = 'Chave do slot deve usar minúsculas, números e _.';
+                elseif (in_array($key, $keys, true)) $errors["{$field}.slot_key"] = 'Chave de slot repetida.';
+                if (!in_array($side, ['BUY', 'SELL'], true)) $errors["{$field}.side"] = 'Lado deve ser BUY ou SELL.';
+                if (!in_array($type, ['CALL', 'PUT'], true)) $errors["{$field}.option_type"] = 'Tipo deve ser CALL ou PUT.';
+                if ($ratio === false || $ratio < 1 || $ratio > 100) $errors["{$field}.ratio"] = 'Proporção deve ser inteiro entre 1 e 100.';
+                $keys[] = $key;
+                $label = trim((string) ($s['label'] ?? ''));
+                $clean[] = ['slot_key' => $key, 'label' => $label !== '' ? $label : $key, 'side' => $side, 'option_type' => $type, 'ratio' => (int) $ratio];
+            }
+        }
+        $constraints = $input['constraints'] ?? [];
+        if ($errors === []) $errors += TemplateConstraints::validateDefinition($constraints, $keys);
+        if ($errors !== []) return ['success' => false, 'status' => 422, 'errors' => $errors];
+
+        try {
+            $this->pdo->beginTransaction();
+            $id = $this->repository->insert($userId, [
+                'name' => $name, 'description' => isset($input['description']) ? trim((string) $input['description']) : null,
+                'slots' => $clean, 'constraints' => $constraints,
+            ]);
+            $this->pdo->commit();
+        } catch (Throwable $e) {
+            if ($this->pdo->inTransaction()) $this->pdo->rollBack();
+            throw $e;
+        }
+        return ['success' => true, 'status' => 201, 'data' => $this->repository->findVisible($userId, $id)];
+    }
+}
diff --git a/app/Services/StructuredPositionService.php b/app/Services/StructuredPositionService.php
new file mode 100644
index 0000000..f316724
--- /dev/null
+++ b/app/Services/StructuredPositionService.php
@@ -0,0 +1,191 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Services;
+
+use App\Domain\TemplateConstraints;
+use App\Repositories\OperationRepository;
+use App\Repositories\StrategyTemplateRepository;
+use App\Repositories\StructuredPositionRepository;
+use DateTimeImmutable;
+use PDO;
+use Throwable;
+
+/**
+ * Registra uma posição estruturada: UM bloco comum + um bloco por slot do modelo.
+ * Lado, tipo, strike, vencimento e multiplicador são derivados do modelo/contrato; quantidade = ratio × base.
+ * Todas as operações do ledger, as pernas e o histórico são gravados em uma única transação.
+ * Convenção de sinais: quantity é sempre positiva; a direção está só em `side`;
+ * gross_cash_flow = −(preço × quantidade × multiplicador) em BUY e + em SELL (aplicado uma única vez).
+ */
+final class StructuredPositionService
+{
+    public function __construct(
+        private readonly PDO $pdo,
+        private readonly StrategyTemplateRepository $templates,
+        private readonly StructuredPositionRepository $positions,
+        private readonly OperationRepository $operations,
+    ) {}
+
+    public function register(int $userId, array $input): array
+    {
+        $errors = [];
+        $templateId = filter_var($input['strategy_template_id'] ?? null, FILTER_VALIDATE_INT);
+        $template = ($templateId === false || $templateId < 1) ? null : $this->templates->findVisible($userId, $templateId);
+        if ($template === null) return $this->fail(['strategy_template_id' => 'Modelo de estratégia inexistente.'], 404);
+        if ($template['needs_review'] || $template['slots'] === []) {
+            return $this->fail(['strategy_template_id' => 'Modelo legado exige revisão antes de ser usado.']);
+        }
+
+        $base = filter_var($input['base_quantity'] ?? null, FILTER_VALIDATE_INT);
+        if ($base === false || $base < 1) $errors['base_quantity'] = 'Informe a quantidade-base como inteiro positivo.';
+
+        $executedAt = (string) ($input['executed_at'] ?? date('Y-m-d H:i:s'));
+        if (DateTimeImmutable::createFromFormat('Y-m-d H:i:s', $executedAt) === false) $errors['executed_at'] = 'Data/hora inválida (use AAAA-MM-DD HH:MM:SS).';
+
+        $legsInput = $input['legs'] ?? null;
+        $byKey = [];
+        if (!is_array($legsInput) || !array_is_list($legsInput)) {
+            $errors['legs'] = 'Informe as pernas da estrutura.';
+        } else {
+            foreach ($legsInput as $i => $leg) {
+                $key = is_array($leg) ? (string) ($leg['slot_key'] ?? '') : '';
+                if ($key === '' || isset($byKey[$key])) { $errors["legs.{$i}.slot_key"] = 'Slot ausente ou repetido.'; continue; }
+                $byKey[$key] = $leg;
+            }
+        }
+        $slotKeys = array_column($template['slots'], 'slot_key');
+        if (!isset($errors['legs'])) {
+            foreach (array_diff($slotKeys, array_keys($byKey)) as $missing) $errors["legs.{$missing}"] = 'Perna obrigatória não informada.';
+            foreach (array_diff(array_keys($byKey), $slotKeys) as $extra) $errors["legs.{$extra}"] = 'Slot não pertence ao modelo.';
+        }
+        // Erros estruturais das pernas impedem a validação por contrato; os demais são acumulados e devolvidos juntos.
+        if (array_filter(array_keys($errors), static fn(string $k): bool => str_starts_with($k, 'legs'))) return $this->fail($errors);
+
+        $contracts = [];
+        $assetId = null;
+        foreach ($template['slots'] as $slot) {
+            $key = $slot['slot_key'];
+            $leg = $byKey[$key];
+            $contractId = filter_var($leg['option_contract_id'] ?? null, FILTER_VALIDATE_INT);
+            $stmt = $this->pdo->prepare("SELECT * FROM option_contracts WHERE id = :id AND user_id = :u AND status = 'ACTIVE'");
+            $stmt->execute(['id' => $contractId === false ? 0 : $contractId, 'u' => $userId]);
+            $contract = $stmt->fetch(PDO::FETCH_ASSOC);
+            if (!$contract) { $errors["legs.{$key}.option_contract_id"] = 'Contrato inexistente, inativo ou de outro usuário.'; continue; }
+            if ($contract['option_type'] !== $slot['option_type']) $errors["legs.{$key}.option_contract_id"] = 'O contrato deve ser do tipo ' . $slot['option_type'] . '.';
+            if ($assetId !== null && (int) $contract['asset_id'] !== $assetId) $errors["legs.{$key}.option_contract_id"] = 'Todas as pernas devem ter o mesmo ativo-objeto.';
+            $assetId ??= (int) $contract['asset_id'];
+            $price = $leg['unit_price'] ?? null;
+            if (!is_numeric($price) || (float) $price < 0) $errors["legs.{$key}.unit_price"] = 'Informe um preço numérico maior ou igual a zero.';
+            $costs = $leg['costs'] ?? 0;
+            if (!is_numeric($costs) || (float) $costs < 0) $errors["legs.{$key}.costs"] = 'Custos devem ser numéricos e não negativos.';
+            $contracts[$key] = $contract;
+        }
+        if ($errors === []) $errors += TemplateConstraints::evaluate($template['constraints'], $contracts);
+        if ($errors !== []) return $this->fail($errors);
+
+        $uuid = $this->uuid();
+        $name = trim((string) ($input['name'] ?? '')) ?: $template['name'];
+        try {
+            $this->pdo->beginTransaction();
+            $positionId = $this->positions->insertPosition([
+                'uuid' => $uuid, 'user_id' => $userId, 'template_id' => $template['id'], 'asset_id' => $assetId,
+                'name' => mb_substr($name, 0, 120), 'base_quantity' => $base, 'executed_at' => $executedAt,
+                'declared' => $template['name'], 'notes' => isset($input['notes']) ? trim((string) $input['notes']) : null,
+            ]);
+            foreach ($template['slots'] as $slot) {
+                $key = $slot['slot_key'];
+                $contract = $contracts[$key];
+                $quantity = $slot['ratio'] * $base;
+                $price = round((float) $byKey[$key]['unit_price'], 6);
+                $costs = round((float) ($byKey[$key]['costs'] ?? 0), 6);
+                $gross = round($price * $quantity * (int) $contract['contract_multiplier'], 6) * ($slot['side'] === 'BUY' ? -1 : 1);
+                $operationId = $this->positions->insertLegOperation([
+                    'user_id' => $userId, 'contract_id' => (int) $contract['id'], 'strategy_id' => $template['legacy_strategy_id'] ?? null,
+                    'structured_id' => $positionId, 'side' => $slot['side'], 'quantity' => $quantity, 'unit_price' => $price,
+                    'gross' => $gross, 'costs' => $costs, 'executed_at' => $executedAt,
+                    'notes' => 'Posição estruturada ' . $uuid . ' — ' . $slot['label'],
+                ]);
+                $this->positions->insertLeg($positionId, $key, $operationId, (int) $contract['id']);
+                $this->operations->insertHistory($userId, $operationId, 'STRUCTURED_POSITION_OPENED', null, [
+                    'structured_position_uuid' => $uuid, 'slot_key' => $key, 'side' => $slot['side'], 'quantity' => $quantity,
+                    'unit_price' => $price, 'costs' => $costs, 'gross_cash_flow' => $gross,
+                ]);
+            }
+            $this->pdo->commit();
+        } catch (Throwable $e) {
+            if ($this->pdo->inTransaction()) $this->pdo->rollBack();
+            throw $e;
+        }
+        return ['success' => true, 'status' => 201, 'data' => $this->find($userId, $uuid)];
+    }
+
+    public function list(int $userId): array
+    {
+        return array_map([$this, 'present'], $this->positions->list($userId));
+    }
+
+    public function find(int $userId, string $uuid): ?array
+    {
+        $p = $this->positions->findByUuid($userId, $uuid);
+        return $p === null ? null : $this->present($p);
+    }
+
+    /** Agrega pernas, descrição legível, fluxo inicial e status derivado do ledger (nunca armazenado). */
+    private function present(array $p): array
+    {
+        $cash = 0.0;
+        $costs = 0.0;
+        $open = 0;
+        $closed = 0;
+        $legs = [];
+        foreach ($p['legs'] as $l) {
+            $qty = (int) $l['quantity'];
+            $closedQty = (int) $l['closed_quantity'];
+            $cash += (float) $l['gross_cash_flow'];
+            $costs += (float) $l['costs'];
+            $open += $qty - $closedQty;
+            $closed += $closedQty;
+            $legs[] = [
+                'slot_key' => $l['slot_key'], 'label' => $l['label'], 'operation_id' => (int) $l['operation_id'],
+                'option_contract_id' => (int) $l['option_contract_id'], 'contract_code' => $l['contract_code'],
+                'side' => $l['side'], 'option_type' => $l['option_type'], 'quantity' => $qty, 'open_quantity' => $qty - $closedQty,
+                'strike_price' => (float) $l['strike_price'], 'expiration_date' => $l['expiration_date'],
+                'unit_price' => (float) $l['unit_price'], 'costs' => (float) $l['costs'], 'gross_cash_flow' => (float) $l['gross_cash_flow'],
+                'description' => self::describe($l),
+            ];
+        }
+        $status = $open === 0 ? 'CLOSED' : ($closed > 0 ? 'PARTIAL' : 'OPEN');
+        return [
+            'uuid' => $p['uuid'], 'name' => $p['name'], 'strategy' => $p['declared_strategy'], 'inferred_strategy' => $p['inferred_strategy'],
+            'strategy_template_id' => (int) $p['strategy_template_id'], 'asset_id' => (int) $p['asset_id'], 'base_quantity' => $p['base_quantity'],
+            'executed_at' => $p['executed_at'], 'status' => $status, 'notes' => $p['notes'],
+            'initial_cash_flow' => round($cash, 6), 'initial_costs' => round($costs, 6),
+            'initial_kind' => $cash < 0 ? 'DEBIT' : ($cash > 0 ? 'CREDIT' : 'ZERO'),
+            'nearest_expiration' => $legs === [] ? null : min(array_column($legs, 'expiration_date')),
+            'legs' => $legs,
+        ];
+    }
+
+    private static function describe(array $l): string
+    {
+        $date = DateTimeImmutable::createFromFormat('Y-m-d', substr((string) $l['expiration_date'], 0, 10));
+        return sprintf('%s %d %s %s, strike %s, vencimento %s', $l['side'] === 'BUY' ? 'Comprar' : 'Vender', (int) $l['quantity'],
+            $l['option_type'] === 'CALL' ? 'Call' : 'Put', $l['contract_code'], rtrim(rtrim(number_format((float) $l['strike_price'], 6, '.', ''), '0'), '.'),
+            $date ? $date->format('d/m/Y') : (string) $l['expiration_date']);
+    }
+
+    private function uuid(): string
+    {
+        $b = random_bytes(16);
+        $b[6] = chr((ord($b[6]) & 0x0f) | 0x40);
+        $b[8] = chr((ord($b[8]) & 0x3f) | 0x80);
