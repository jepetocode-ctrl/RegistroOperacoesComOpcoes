+<?php
+
+declare(strict_types=1);
+
+namespace App\Repositories;
+
+use PDO;
+
+final class StrategyTemplateRepository
+{
+    public function __construct(private readonly PDO $pdo) {}
+
+    /** Modelos visíveis ao usuário: catálogo do sistema (user_id NULL) + os do próprio usuário. */
+    public function listVisible(int $userId): array
+    {
+        $stmt = $this->pdo->prepare("SELECT * FROM strategy_templates WHERE status = 'ACTIVE' AND (user_id IS NULL OR user_id = :u) ORDER BY (user_id IS NOT NULL), name, id");
+        $stmt->execute(['u' => $userId]);
+        return array_map(fn(array $t): array => $this->hydrate($t), $stmt->fetchAll(PDO::FETCH_ASSOC));
+    }
+
+    public function findVisible(int $userId, int $id): ?array
+    {
+        $stmt = $this->pdo->prepare("SELECT * FROM strategy_templates WHERE id = :id AND status = 'ACTIVE' AND (user_id IS NULL OR user_id = :u)");
+        $stmt->execute(['id' => $id, 'u' => $userId]);
+        $row = $stmt->fetch(PDO::FETCH_ASSOC);
+        return $row === false ? null : $this->hydrate($row);
+    }
+
+    public function insert(int $userId, array $data): int
+    {
+        $stmt = $this->pdo->prepare("INSERT INTO strategy_templates (user_id, name, description, origin, constraints) VALUES (:u,:name,:description,'USER',:constraints)");
+        $stmt->execute(['u' => $userId, 'name' => $data['name'], 'description' => $data['description'], 'constraints' => json_encode($data['constraints'], JSON_THROW_ON_ERROR)]);
+        $id = (int) $this->pdo->lastInsertId();
+        $slot = $this->pdo->prepare('INSERT INTO strategy_template_slots (template_id, position, slot_key, label, side, option_type, ratio) VALUES (:t,:p,:k,:l,:s,:o,:r)');
+        foreach ($data['slots'] as $pos => $s) {
+            $slot->execute(['t' => $id, 'p' => $pos + 1, 'k' => $s['slot_key'], 'l' => $s['label'], 's' => $s['side'], 'o' => $s['option_type'], 'r' => $s['ratio']]);
+        }
+        return $id;
+    }
+
+    private function hydrate(array $t): array
+    {
+        $slots = $this->pdo->prepare('SELECT slot_key, label, instrument_type, side, option_type, ratio, position FROM strategy_template_slots WHERE template_id = :id ORDER BY position');
+        $slots->execute(['id' => $t['id']]);
+        $t['id'] = (int) $t['id'];
+        $t['user_id'] = $t['user_id'] === null ? null : (int) $t['user_id'];
+        $t['needs_review'] = (int) $t['needs_review'] === 1;
+        $t['constraints'] = $t['constraints'] === null ? [] : (json_decode((string) $t['constraints'], true) ?: []);
+        $t['slots'] = array_map(static function (array $s): array { $s['ratio'] = (int) $s['ratio']; $s['position'] = (int) $s['position']; return $s; }, $slots->fetchAll(PDO::FETCH_ASSOC));
+        return $t;
+    }
+}
