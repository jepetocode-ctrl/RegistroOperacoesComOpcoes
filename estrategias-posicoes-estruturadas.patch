+        self::assertSame(300.0, $result['data']['initial_cash_flow']); // +500 − 200
+        self::assertSame('CREDIT', $result['data']['initial_kind']);
+    }
+
+    public function testRatioMultipliesBaseQuantity(): void
+    {
+        $result = $this->service->register(1, [
+            'strategy_template_id' => $this->templateId('long_call_fly'), 'base_quantity' => 3, 'executed_at' => '2026-10-24 10:00:00',
+            'legs' => [
+                ['slot_key' => 'wing_low', 'option_contract_id' => 1, 'unit_price' => 12, 'costs' => 1.5],
+                ['slot_key' => 'body', 'option_contract_id' => 2, 'unit_price' => 6],
+                ['slot_key' => 'wing_high', 'option_contract_id' => 3, 'unit_price' => 2],
