diff --git a/app/Domain/TemplateConstraints.php b/app/Domain/TemplateConstraints.php
new file mode 100644
index 0000000..534ff05
--- /dev/null
+++ b/app/Domain/TemplateConstraints.php
@@ -0,0 +1,91 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Domain;
+
+/**
+ * Restrições declarativas entre slots de um modelo de estratégia.
+ * Nunca executa conteúdo recebido: apenas interpreta tipos conhecidos.
+ *
+ * Tipos suportados:
+ *  - strike_order: {"type":"strike_order","slots":["a","b","c"]}  => strike(a) < strike(b) < strike(c)
+ *  - same_strike:  {"type":"same_strike","slots":["a","b"]}
+ *  - same_expiration: {"type":"same_expiration","slots":["a","b"]}
+ */
+final class TemplateConstraints
+{
+    public const TYPES = ['strike_order', 'same_strike', 'same_expiration'];
+
+    /** @return array<string,string> erros indexados por campo */
+    public static function validateDefinition(mixed $constraints, array $slotKeys): array
+    {
+        if (!is_array($constraints) || ($constraints !== [] && !array_is_list($constraints))) {
+            return ['constraints' => 'Restrições devem ser uma lista.'];
+        }
+        $errors = [];
+        foreach ($constraints as $i => $c) {
+            $field = "constraints.{$i}";
+            if (!is_array($c) || !in_array($c['type'] ?? null, self::TYPES, true)) {
+                $errors[$field] = 'Tipo de restrição desconhecido.';
+                continue;
+            }
+            $slots = $c['slots'] ?? null;
+            if (!is_array($slots) || !array_is_list($slots) || count($slots) < 2 || count($slots) !== count(array_unique($slots))) {
+                $errors[$field] = 'Informe ao menos 2 slots distintos.';
+                continue;
+            }
+            foreach ($slots as $key) {
+                if (!is_string($key) || !in_array($key, $slotKeys, true)) {
+                    $errors[$field] = 'A restrição referencia um slot inexistente.';
+                    break;
+                }
+            }
+        }
+        return $errors;
+    }
+
+    /**
+     * @param array<string,array{strike_price:mixed,expiration_date:mixed}> $contractsBySlot
+     * @return array<string,string>
+     */
+    public static function evaluate(array $constraints, array $contractsBySlot): array
+    {
+        $errors = [];
+        foreach ($constraints as $i => $c) {
+            $slots = $c['slots'];
+            $field = "constraints.{$i}";
+            switch ($c['type']) {
+                case 'strike_order':
+                    for ($k = 0; $k < count($slots) - 1; $k++) {
+                        $a = (float) $contractsBySlot[$slots[$k]]['strike_price'];
+                        $b = (float) $contractsBySlot[$slots[$k + 1]]['strike_price'];
+                        if (!($a < $b - 1e-9)) {
+                            $errors[$field] = "O strike de {$slots[$k]} deve ser menor que o de {$slots[$k + 1]}.";
+                            break;
+                        }
+                    }
+                    break;
+                case 'same_strike':
+                    $first = (float) $contractsBySlot[$slots[0]]['strike_price'];
+                    foreach ($slots as $s) {
+                        if (abs((float) $contractsBySlot[$s]['strike_price'] - $first) > 1e-9) {
+                            $errors[$field] = 'Os slots ' . implode(', ', $slots) . ' devem ter o mesmo strike.';
+                            break;
+                        }
+                    }
+                    break;
+                case 'same_expiration':
+                    $first = (string) $contractsBySlot[$slots[0]]['expiration_date'];
+                    foreach ($slots as $s) {
+                        if ((string) $contractsBySlot[$s]['expiration_date'] !== $first) {
+                            $errors[$field] = 'Os slots ' . implode(', ', $slots) . ' devem ter o mesmo vencimento.';
+                            break;
+                        }
+                    }
+                    break;
+            }
+        }
+        return $errors;
+    }
+}
