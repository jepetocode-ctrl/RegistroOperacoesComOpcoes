+
+final class StructuredPositionTest extends TestCase
+{
+    private PDO $pdo;
+    private StructuredPositionService $service;
+    private StrategyTemplateService $templates;
+
+    protected function setUp(): void
+    {
+        $this->pdo = new PDO('sqlite::memory:');
+        $this->pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
+        $this->pdo->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);
+        $this->pdo->exec('PRAGMA foreign_keys = ON');
+        $this->pdo->exec('CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE NOT NULL, password_hash TEXT NOT NULL)');
+        $this->pdo->exec("CREATE TABLE assets (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, symbol TEXT NOT NULL, name TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'ACTIVE', FOREIGN KEY(user_id) REFERENCES users(id))");
+        $this->pdo->exec('CREATE TABLE strategies (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, name TEXT NOT NULL, description TEXT NULL, legs TEXT NULL, FOREIGN KEY(user_id) REFERENCES users(id))');
+        $this->pdo->exec("CREATE TABLE option_contracts (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, asset_id INTEGER NOT NULL, code TEXT NOT NULL, option_type TEXT NOT NULL, strike_price NUMERIC NOT NULL, expiration_date TEXT NOT NULL, contract_multiplier INTEGER NOT NULL DEFAULT 100, status TEXT NOT NULL DEFAULT 'ACTIVE', FOREIGN KEY(user_id) REFERENCES users(id), FOREIGN KEY(asset_id) REFERENCES assets(id))");
+        $this->pdo->exec("INSERT INTO users (username,password_hash) VALUES ('owner','h'),('other','h2')");
+        $this->pdo->exec("INSERT INTO assets (user_id,symbol,name) VALUES (1,'PETR4','Petrobras'),(1,'VALE3','Vale'),(2,'PETR4','Petrobras')");
+        // user 1, ativo 1: ids 1..5 ; ativo 2: id 6 ; user 2: id 7
+        $this->pdo->exec("INSERT INTO option_contracts (user_id,asset_id,code,option_type,strike_price,expiration_date) VALUES
+            (1,1,'PETRC90','CALL',90,'2026-12-18'),
+            (1,1,'PETRC100','CALL',100,'2026-12-18'),
+            (1,1,'PETRC110','CALL',110,'2026-12-18'),
+            (1,1,'PETRC110J','CALL',110,'2027-01-15'),
+            (1,1,'PETRP90','PUT',90,'2026-12-18'),
+            (1,2,'VALEC100','CALL',100,'2026-12-18'),
+            (2,3,'PETRC100','CALL',100,'2026-12-18')");
+        require_once dirname(__DIR__, 2) . '/database/migrations/20261023_000003_create_operations_and_positions.php';
+        require_once dirname(__DIR__, 2) . '/database/migrations/20261024_000006_create_structured_positions.php';
+        (new CreateOperationsAndPositions())->up($this->pdo);
+        (new CreateStructuredPositions())->up($this->pdo);
+        $repo = new StrategyTemplateRepository($this->pdo);
+        $this->templates = new StrategyTemplateService($this->pdo, $repo);
+        $this->service = new StructuredPositionService($this->pdo, $repo, new StructuredPositionRepository($this->pdo), new OperationRepository($this->pdo));
+    }
+
+    private function templateId(string $code): int
+    {
+        $stmt = $this->pdo->prepare('SELECT id FROM strategy_templates WHERE user_id IS NULL AND code = :c');
+        $stmt->execute(['c' => $code]);
+        return (int) $stmt->fetchColumn();
+    }
+
+    private function rows(string $table): int
+    {
+        return (int) $this->pdo->query("SELECT COUNT(*) FROM {$table}")->fetchColumn();
+    }
+
+    private function callSpread(array $overrides = []): array
+    {
+        return array_replace([
+            'strategy_template_id' => $this->templateId('call_spread_buy'), 'base_quantity' => 2, 'executed_at' => '2026-10-24 10:00:00',
+            'legs' => [
+                ['slot_key' => 'long_call', 'option_contract_id' => 2, 'unit_price' => '5.00'],
+                ['slot_key' => 'short_call', 'option_contract_id' => 3, 'unit_price' => '2.00'],
+            ],
+        ], $overrides);
+    }
+
+    public function testCatalogIsSeededOnceAndIsIdempotent(): void
+    {
+        $before = $this->rows('strategy_templates');
+        self::assertGreaterThanOrEqual(17, $before);
+        (new CreateStructuredPositions())->up($this->pdo);
+        self::assertSame($before, $this->rows('strategy_templates'));
+        self::assertSame('REGISTRATION', $this->pdo->query("SELECT support_level FROM strategy_templates WHERE code='call_spread_buy'")->fetchColumn());
+    }
+
+    public function testCallSpreadCreatesOneOperationPerLegWithDerivedFieldsAndInitialDebit(): void
+    {
+        $result = $this->service->register(1, $this->callSpread());
+        self::assertTrue($result['success'], json_encode($result));
+        $p = $result['data'];
+
+        self::assertSame('Compra de Call Spread', $p['strategy']);
+        self::assertSame('OPEN', $p['status']);
+        self::assertSame(2, $this->rows('operations'));
+        self::assertSame(2, $this->rows('structured_position_legs'));
+        // BUY 5,00 × 2 × 100 = −1000 ; SELL 2,00 × 2 × 100 = +400 ; líquido −600 (débito)
+        self::assertSame(-600.0, $p['initial_cash_flow']);
+        self::assertSame('DEBIT', $p['initial_kind']);
+        self::assertSame('2026-12-18', $p['nearest_expiration']);
+        [$long, $short] = $p['legs'];
