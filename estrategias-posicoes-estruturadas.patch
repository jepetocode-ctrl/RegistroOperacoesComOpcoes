--- /dev/null
+++ b/app/Domain/LegacyStrategyConverter.php
@@ -0,0 +1,55 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Domain;
+
+/** Converte o JSON legado de strategies.legs em slots, sem nunca descartar dados silenciosamente. */
+final class LegacyStrategyConverter
+{
+    /**
+     * @param callable(string):?string $resolveOptionType retorna CALL/PUT para um código de contrato do usuário
+     * @return array{slots:list<array<string,mixed>>,constraints:list<mixed>,needs_review:bool,reason:?string}
+     */
+    public static function convert(?string $rawLegs, callable $resolveOptionType): array
+    {
+        $fail = static fn(string $reason): array => ['slots' => [], 'constraints' => [], 'needs_review' => true, 'reason' => $reason];
+        if ($rawLegs === null || trim($rawLegs) === '') {
+            return $fail('Estratégia legada sem pernas informadas.');
+        }
+        $decoded = json_decode($rawLegs, true);
+        if (json_last_error() !== JSON_ERROR_NONE || !is_array($decoded) || $decoded === [] || !array_is_list($decoded)) {
+            return $fail('JSON de pernas inválido ou fora do formato de lista.');
+        }
+        $slots = [];
+        foreach ($decoded as $n => $leg) {
+            $i = $n + 1;
+            if (!is_array($leg)) {
+                return $fail("Perna {$i} não é um objeto.");
+            }
+            $side = strtoupper((string) ($leg['side'] ?? ''));
+            if (!in_array($side, ['BUY', 'SELL'], true)) {
+                return $fail("Perna {$i} sem lado BUY/SELL válido.");
+            }
+            $type = strtoupper((string) ($leg['option_type'] ?? ''));
+            if (!in_array($type, ['CALL', 'PUT'], true)) {
+                $code = (string) ($leg['contract_code'] ?? '');
+                $type = $code !== '' ? (string) $resolveOptionType($code) : '';
+            }
+            if (!in_array($type, ['CALL', 'PUT'], true)) {
+                return $fail("Perna {$i} sem tipo CALL/PUT identificável.");
+            }
+            $ratio = $leg['ratio'] ?? $leg['quantity'] ?? 1;
+            $ratio = filter_var($ratio, FILTER_VALIDATE_INT);
+            if ($ratio === false || $ratio < 1) {
+                return $fail("Perna {$i} com proporção inválida.");
+            }
+            $slots[] = [
+                'slot_key' => "leg_{$i}",
+                'label' => sprintf('Perna %d — %s de %s', $i, $side === 'BUY' ? 'Compra' : 'Venda', $type === 'CALL' ? 'Call' : 'Put'),
+                'side' => $side, 'option_type' => $type, 'ratio' => $ratio,
+            ];
+        }
+        return ['slots' => $slots, 'constraints' => [], 'needs_review' => false, 'reason' => null];
+    }
+}
