+
+        $unknown = $this->templates->create(1, ['name' => 'X', 'slots' => [['slot_key' => 'a', 'side' => 'BUY', 'option_type' => 'CALL']],
+            'constraints' => [['type' => 'strike_order', 'slots' => ['a', 'zzz']]]]);
+        self::assertArrayHasKey('constraints.0', $unknown['errors']);
+        $evil = $this->templates->create(1, ['name' => 'X', 'slots' => [['slot_key' => 'a', 'side' => 'BUY', 'option_type' => 'CALL']],
