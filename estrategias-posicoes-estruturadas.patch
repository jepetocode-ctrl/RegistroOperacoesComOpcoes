@@ -0,0 +1,70 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Controllers;
+
+use App\Middleware\AuthMiddleware;
+use App\Middleware\CsrfMiddleware;
+use App\Repositories\OperationRepository;
+use App\Repositories\StrategyTemplateRepository;
+use App\Repositories\StructuredPositionRepository;
+use App\Services\StrategyTemplateService;
+use App\Services\StructuredPositionService;
+use App\Support\Database;
+use App\Support\Request;
+use App\Support\Response;
+use App\Support\SessionManager;
+
+/** /api/strategy-templates (modelos/esqueletos) e /api/structured-positions (instâncias). */
+final class StructuredPositionController
+{
+    private StrategyTemplateService $templates;
+    private StructuredPositionService $positions;
+
+    public function __construct()
+    {
+        $pdo = Database::defaultConnection();
+        $templateRepo = new StrategyTemplateRepository($pdo);
+        $this->templates = new StrategyTemplateService($pdo, $templateRepo);
+        $this->positions = new StructuredPositionService($pdo, $templateRepo, new StructuredPositionRepository($pdo), new OperationRepository($pdo));
+    }
+
+    public function handle(): void
+    {
+        if (!AuthMiddleware::isAuthenticated()) { Response::json(['success' => false, 'message' => 'Não autenticado.'], 401); return; }
+        $method = Request::method();
+        if (in_array($method, ['POST', 'PUT', 'PATCH', 'DELETE'], true) && !CsrfMiddleware::validate()) { Response::json(['success' => false, 'message' => 'Token CSRF inválido.'], 419); return; }
+        $userId = (int) SessionManager::user()['id'];
+        $parts = explode('/', trim(parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH) ?: '/', '/'));
+        $resource = $parts[1] ?? '';
+        $ref = $parts[2] ?? null;
+
+        if ($resource === 'strategy-templates') {
+            if ($method === 'GET' && $ref === null) { Response::json(['success' => true, 'data' => $this->templates->list($userId)]); return; }
+            if ($method === 'GET' && ctype_digit((string) $ref)) {
+                $t = $this->templates->find($userId, (int) $ref);
+                $t === null ? Response::json(['success' => false, 'message' => 'Modelo não encontrado.'], 404) : Response::json(['success' => true, 'data' => $t]);
+                return;
+            }
+            if ($method === 'POST' && $ref === null) { $this->respond($this->templates->create($userId, Request::all())); return; }
+        }
+        if ($resource === 'structured-positions') {
+            if ($method === 'GET' && $ref === null) { Response::json(['success' => true, 'data' => $this->positions->list($userId)]); return; }
+            if ($method === 'GET' && $ref !== null) {
+                $p = $this->positions->find($userId, (string) $ref);
+                $p === null ? Response::json(['success' => false, 'message' => 'Posição estruturada não encontrada.'], 404) : Response::json(['success' => true, 'data' => $p]);
+                return;
+            }
+            if ($method === 'POST' && $ref === null) { $this->respond($this->positions->register($userId, Request::all())); return; }
+        }
+        Response::json(['success' => false, 'message' => 'Rota não encontrada.'], 404);
+    }
+
+    private function respond(array $result): void
+    {
+        $status = (int) ($result['status'] ?? 200);
+        unset($result['status']);
+        Response::json($result, $status);
+    }
+}
diff --git a/app/Domain/LegacyStrategyConverter.php b/app/Domain/LegacyStrategyConverter.php
