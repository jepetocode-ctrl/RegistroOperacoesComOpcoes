@@ -0,0 +1,65 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Repositories;
+
+use PDO;
+
+final class StructuredPositionRepository
+{
+    public function __construct(private readonly PDO $pdo) {}
+
+    public function insertPosition(array $d): int
+    {
+        $stmt = $this->pdo->prepare('INSERT INTO structured_positions (uuid, user_id, strategy_template_id, asset_id, name, base_quantity, executed_at, declared_strategy, notes) VALUES (:uuid,:user_id,:template_id,:asset_id,:name,:base_quantity,:executed_at,:declared,:notes)');
+        $stmt->execute($d);
+        return (int) $this->pdo->lastInsertId();
+    }
+
+    /** Insere a operação do ledger já vinculada à posição estruturada (append-only: sem UPDATE posterior). */
+    public function insertLegOperation(array $d): int
+    {
+        $stmt = $this->pdo->prepare("INSERT INTO operations (user_id, option_contract_id, strategy_id, structured_position_id, side, quantity, unit_price, gross_cash_flow, costs, executed_at, operation_kind, notes) VALUES (:user_id,:contract_id,:strategy_id,:structured_id,:side,:quantity,:unit_price,:gross,:costs,:executed_at,'OPEN',:notes)");
+        $stmt->execute($d);
+        return (int) $this->pdo->lastInsertId();
+    }
+
+    public function insertLeg(int $positionId, string $slotKey, int $operationId, int $contractId): void
+    {
+        $stmt = $this->pdo->prepare('INSERT INTO structured_position_legs (structured_position_id, slot_key, operation_id, option_contract_id) VALUES (:p,:k,:o,:c)');
+        $stmt->execute(['p' => $positionId, 'k' => $slotKey, 'o' => $operationId, 'c' => $contractId]);
+    }
+
+    public function list(int $userId): array
+    {
+        $stmt = $this->pdo->prepare('SELECT * FROM structured_positions WHERE user_id = :u ORDER BY executed_at DESC, id DESC');
+        $stmt->execute(['u' => $userId]);
+        return array_map(fn(array $p): array => $this->hydrate($userId, $p), $stmt->fetchAll(PDO::FETCH_ASSOC));
+    }
+
+    public function findByUuid(int $userId, string $uuid): ?array
+    {
+        $stmt = $this->pdo->prepare('SELECT * FROM structured_positions WHERE user_id = :u AND uuid = :uuid');
+        $stmt->execute(['u' => $userId, 'uuid' => $uuid]);
+        $row = $stmt->fetch(PDO::FETCH_ASSOC);
+        return $row === false ? null : $this->hydrate($userId, $row);
+    }
+
+    private function hydrate(int $userId, array $p): array
+    {
+        $legs = $this->pdo->prepare("SELECT l.slot_key, l.operation_id, o.option_contract_id, o.side, o.quantity, o.unit_price, o.costs, o.gross_cash_flow, c.code AS contract_code, c.option_type, c.strike_price, c.expiration_date, c.contract_multiplier, s.label, s.position,
+            COALESCE((SELECT SUM(cl.quantity) FROM operation_closures cl WHERE cl.user_id = o.user_id AND cl.opening_operation_id = o.id), 0) AS closed_quantity
+            FROM structured_position_legs l
+            JOIN operations o ON o.id = l.operation_id AND o.user_id = :u
+            JOIN option_contracts c ON c.id = o.option_contract_id
+            JOIN structured_positions sp ON sp.id = l.structured_position_id
+            LEFT JOIN strategy_template_slots s ON s.template_id = sp.strategy_template_id AND s.slot_key = l.slot_key
+            WHERE l.structured_position_id = :p ORDER BY s.position, l.id");
+        $legs->execute(['u' => $userId, 'p' => $p['id']]);
+        $p['id'] = (int) $p['id'];
+        $p['base_quantity'] = (int) $p['base_quantity'];
+        $p['legs'] = $legs->fetchAll(PDO::FETCH_ASSOC);
+        return $p;
+    }
+}
