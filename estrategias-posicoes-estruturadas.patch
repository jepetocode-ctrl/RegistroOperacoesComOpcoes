+        self::assertTrue($result['success'], json_encode($result));
+        $q = array_column($result['data']['legs'], 'quantity', 'slot_key');
+        self::assertSame(['wing_low' => 3, 'body' => 6, 'wing_high' => 3], $q);
+        // −12·3·100 + 6·6·100 − 2·3·100 = −3600 + 3600 − 600 = −600
+        self::assertSame(-600.0, $result['data']['initial_cash_flow']);
