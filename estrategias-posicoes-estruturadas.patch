diff --git a/tests/Feature/LegacyStrategyMigrationTest.php b/tests/Feature/LegacyStrategyMigrationTest.php
new file mode 100644
index 0000000..dacd82d
--- /dev/null
+++ b/tests/Feature/LegacyStrategyMigrationTest.php
@@ -0,0 +1,97 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Tests\Feature;
+
+use App\Domain\LegacyStrategyConverter;
+use Database\Migrations\CreateOperationsAndPositions;
+use Database\Migrations\CreateStructuredPositions;
+use PDO;
+use PHPUnit\Framework\TestCase;
+
+final class LegacyStrategyMigrationTest extends TestCase
+{
+    private PDO $pdo;
+
+    protected function setUp(): void
+    {
+        $this->pdo = new PDO('sqlite::memory:');
+        $this->pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
+        $this->pdo->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);
+        $this->pdo->exec('PRAGMA foreign_keys = ON');
+        $this->pdo->exec('CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE NOT NULL, password_hash TEXT NOT NULL)');
+        $this->pdo->exec("CREATE TABLE assets (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, symbol TEXT NOT NULL, name TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'ACTIVE')");
+        $this->pdo->exec('CREATE TABLE strategies (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, name TEXT NOT NULL, description TEXT NULL, legs TEXT NULL, FOREIGN KEY(user_id) REFERENCES users(id))');
+        $this->pdo->exec("CREATE TABLE option_contracts (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, asset_id INTEGER NOT NULL, code TEXT NOT NULL, option_type TEXT NOT NULL, strike_price NUMERIC NOT NULL, expiration_date TEXT NOT NULL, contract_multiplier INTEGER NOT NULL DEFAULT 100, status TEXT NOT NULL DEFAULT 'ACTIVE')");
+        $this->pdo->exec("INSERT INTO users (username,password_hash) VALUES ('u','h')");
+        $this->pdo->exec("INSERT INTO assets (user_id,symbol,name) VALUES (1,'PETR4','Petrobras')");
+        $this->pdo->exec("INSERT INTO option_contracts (user_id,asset_id,code,option_type,strike_price,expiration_date) VALUES (1,1,'PETR C100','CALL',100,'2026-12-18')");
+        require_once dirname(__DIR__, 2) . '/database/migrations/20261023_000003_create_operations_and_positions.php';
+        require_once dirname(__DIR__, 2) . '/database/migrations/20261024_000006_create_structured_positions.php';
+        (new CreateOperationsAndPositions())->up($this->pdo);
+    }
+
+    private function legacy(int $id): array
+    {
+        return $this->pdo->query("SELECT * FROM strategy_templates WHERE legacy_strategy_id = {$id}")->fetch();
+    }
+
+    public function testLegacyStrategiesAreConvertedOrFlaggedWithoutDataLoss(): void
+    {
+        $invalid = '[{"side":"BUY",';
+        $insert = $this->pdo->prepare('INSERT INTO strategies (user_id, name, legs) VALUES (1, :n, :l)');
+        foreach ([['Explícita', '[{"side":"BUY","option_type":"CALL"},{"side":"SELL","option_type":"CALL","quantity":2}]'],
+                  ['Por contrato', '[{"side":"BUY","contract_code":"PETR C100"}]'],
+                  ['JSON inválido', $invalid], ['Sem pernas', null], ['Código desconhecido', '[{"side":"BUY","contract_code":"NAOEXISTE"}]']] as [$n, $l]) {
+            $insert->execute(['n' => $n, 'l' => $l]);
+        }
+        $this->pdo->exec("INSERT INTO operations (user_id, option_contract_id, strategy_id, side, quantity, unit_price, gross_cash_flow, executed_at) VALUES (1,1,1,'BUY',1,5,-500,'2026-10-24 10:00:00')");
+
+        (new CreateStructuredPositions())->up($this->pdo);
+
+        $explicit = $this->legacy(1);
+        self::assertSame(0, (int) $explicit['needs_review']);
+        self::assertSame('LEGACY', $explicit['origin']);
+        $slots = $this->pdo->query("SELECT slot_key, side, option_type, ratio FROM strategy_template_slots WHERE template_id = {$explicit['id']} ORDER BY position")->fetchAll();
+        self::assertSame([['slot_key' => 'leg_1', 'side' => 'BUY', 'option_type' => 'CALL', 'ratio' => 1], ['slot_key' => 'leg_2', 'side' => 'SELL', 'option_type' => 'CALL', 'ratio' => 2]], $slots);
+
+        self::assertSame(0, (int) $this->legacy(2)['needs_review']);
+
+        $bad = $this->legacy(3);
+        self::assertSame(1, (int) $bad['needs_review']);
+        self::assertSame($invalid, $bad['legacy_legs'], 'O JSON original inválido deve ser preservado.');
+        self::assertSame(0, (int) $this->pdo->query("SELECT COUNT(*) FROM strategy_template_slots WHERE template_id = {$bad['id']}")->fetchColumn());
+        self::assertSame(1, (int) $this->legacy(4)['needs_review']);
+        self::assertSame(1, (int) $this->legacy(5)['needs_review']);
+
+        // dados antigos intactos
+        self::assertSame(5, (int) $this->pdo->query('SELECT COUNT(*) FROM strategies')->fetchColumn());
+        self::assertSame(1, (int) $this->pdo->query('SELECT strategy_id FROM operations')->fetchColumn());
+        self::assertNull($this->pdo->query('SELECT structured_position_id FROM operations')->fetchColumn());
+
+        // idempotente
+        $total = (int) $this->pdo->query('SELECT COUNT(*) FROM strategy_templates')->fetchColumn();
+        (new CreateStructuredPositions())->up($this->pdo);
+        self::assertSame($total, (int) $this->pdo->query('SELECT COUNT(*) FROM strategy_templates')->fetchColumn());
+    }
+
+    public function testConverterRejectsInvalidShapesInsteadOfReturningEmptyList(): void
+    {
+        $none = static fn(string $c): ?string => null;
+        foreach (['{"side":"BUY"}', '[]', '"texto"', '[1]', '[{"side":"HOLD","option_type":"CALL"}]', '[{"side":"BUY","option_type":"CALL","ratio":0}]'] as $raw) {
+            $r = LegacyStrategyConverter::convert($raw, $none);
+            self::assertTrue($r['needs_review'], $raw);
+            self::assertNotNull($r['reason']);
+        }
+    }
+
+    public function testMigrationCanBeRolledBack(): void
+    {
+        (new CreateStructuredPositions())->up($this->pdo);
+        (new CreateStructuredPositions())->down($this->pdo);
+        self::assertSame(0, (int) $this->pdo->query("SELECT COUNT(*) FROM sqlite_master WHERE name IN ('strategy_templates','structured_positions')")->fetchColumn());
+        $cols = array_column($this->pdo->query('PRAGMA table_info(operations)')->fetchAll(), 'name');
+        self::assertNotContains('structured_position_id', $cols);
+    }
+}
