+        self::assertSame(['SELL', 2, 400.0], [$short['side'], $short['quantity'], $short['gross_cash_flow']]);
+        self::assertSame('Comprar 2 Call PETRC100, strike 100, vencimento 18/12/2026', $long['description']);
+        self::assertSame('Vender 2 Call PETRC110, strike 110, vencimento 18/12/2026', $short['description']);
+        self::assertSame(2, (int) $this->pdo->query('SELECT COUNT(*) FROM operations WHERE structured_position_id IS NOT NULL')->fetchColumn());
+        self::assertSame(2, (int) $this->pdo->query("SELECT COUNT(*) FROM operation_history WHERE action='STRUCTURED_POSITION_OPENED'")->fetchColumn());
+    }
+
+    public function testCreditStructureIsReportedAsCredit(): void
+    {
+        $result = $this->service->register(1, $this->callSpread([
+            'strategy_template_id' => $this->templateId('call_spread_sell'), 'base_quantity' => 1,
+            'legs' => [
+                ['slot_key' => 'short_call', 'option_contract_id' => 2, 'unit_price' => 5],
+                ['slot_key' => 'long_call', 'option_contract_id' => 3, 'unit_price' => 2],
