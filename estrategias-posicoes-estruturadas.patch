+
+    public function testTemplateCreationValidatesSlotsAndConstraints(): void
+    {
+        $bad = $this->templates->create(1, ['name' => '', 'slots' => [
+            ['slot_key' => 'A b', 'side' => 'HOLD', 'option_type' => 'X', 'ratio' => 0],
+            ['slot_key' => 'ok', 'side' => 'BUY', 'option_type' => 'CALL'], ['slot_key' => 'ok', 'side' => 'BUY', 'option_type' => 'CALL'],
