+
+    public function testStrikeOrderViolationIsRejectedWithoutWritingAnything(): void
+    {
+        $result = $this->service->register(1, $this->callSpread(['legs' => [
+            ['slot_key' => 'long_call', 'option_contract_id' => 3, 'unit_price' => 5],
